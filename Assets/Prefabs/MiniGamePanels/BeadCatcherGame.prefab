    \"\uD68C\uC0AC\"\uB77C \uD569\uB2C8\uB2E4)\uB294 \uAC00\uC785\uC790\uC758 \uD504\uB77C\uC774\uBC84\uC2DC\uB97C
    \uC801\uADF9\uC801\uC73C\uB85C \uBCF4\uD638\uD558\uBA70 \"\uAC1C\uC778\uC815\uBCF4\uBCF4\uD638\uBC95\",\"\uC815\uBCF4\uD1B5\uC2E0\uB9DD
    \uC774\uC6A9\uCD09\uC9C4 \uBC0F \uC815\uBCF4\uBCF4\uD638\uC5D0 \uAD00\uD55C \uBC95\uB960\",
    \"\uC804\uC790\uC11C\uBA85\uBC95\" \uB4F1 \uD68C\uC0AC\uC5D0\uC11C \uC81C\uACF5\uD558\uB294
    \uACF5\uC778\uC778\uC99D\uC11C\uBE44\uC2A4, \uAE00\uB85C\uBC8C\uC778\uC99D\uC11C\uBE44\uC2A4,
    \uC720\uB2C8\uC0AC\uC778\uC11C\uBE44\uC2A4, \uD074\uB77C\uC6B0\uB4DC\uC0AC\uC778\uC11C\uBE44\uC2A4(\uC774\uD558
    \"\uC11C\uBE44\uC2A4\"\uB77C \uD569\uB2C8\uB2E4.) \uAD00\uB828 \uAC1C\uC778\uC815\uBCF4\uBCF4\uD638
    \uBC95\uADDC\uB97C \uC900\uC218\uD558\uAE30 \uC704\uD558\uC5EC \uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\uC744
    \uC81C\uC815\uD558\uACE0 \uC774\uB97C \uC900\uC218\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
